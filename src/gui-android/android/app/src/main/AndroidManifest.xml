<?xml version="1.0" encoding="utf-8"?>
<!--
  RPCEmu on Android. One machine at a time, so there is one activity that runs a
  machine (RPCEmuActivity, an SDLActivity) and one that chooses which machine to
  run (MachineListActivity, the launcher).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A pointing device is genuinely useful here: RISC OS is a three-button
         mouse desktop, and Android supports real mice, so one plugged in or paired
         gives the proper experience. Not required, because touch is the fallback. -->
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.AppCompat.DayNight">

        <activity
            android:name=".MachineListActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The machine itself. singleInstance and alwaysRetainTaskState because a
          running emulated machine must not be recreated by a configuration change:
          rotating the tablet would otherwise restart RISC OS.
        -->
        <activity
            android:name=".RPCEmuActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:preferMinimalPostProcessing="true"
            android:exported="false" />
    </application>
</manifest>
