+    if (expcard_base != 0)
+    {
+        unsigned char enabled;
+
+        /* A podule device vector is claimed with the address of the status
+           byte to test and the bit in it, and the kernel calls only the
+           first claimant whose bit is set. Give it the card's own byte and
+           the card's own bit so this matches nothing but this card. */
