+/*---------------------------------------------------------------------------*/
+/* Controllers on an expansion card                                          */
+/*---------------------------------------------------------------------------*/
+/*
+ * This driver finds controllers by asking the machine's HAL what USB hardware
+ * exists. A machine whose HAL has no USB support at all - IOMD, for one - can
+ * still carry an OHCI controller on an expansion card, and a module cannot
+ * make up the difference: OS_Hardware can add a device, but HAL entries live
+ * in the ROM.
+ *
+ * So the expansion cards are searched directly instead, after PCI and the HAL
+ * have both come up empty. A card is identified by what is in it rather than
+ * by where it is: every card that has EASI space is asked for its controller
+ * revision, and the one that answers like an OHCI controller is the one. A
+ * slot number would be shorter and would break the moment the card moved.
+ */
+
+/* Base address of the card we settled on; zero if we are not driving one. */
+static int expcard_base = 0;
+
+/* Which slot to use, from an E command tail. */
+#define EXPCARD_NONE (-1)     /* no E tail: search every slot */
+static int expcard_slot = EXPCARD_NONE;
+
+/* How many expansion cards there are to look through. */
+#define EXPCARD_COUNT 8
+
+/* The IOC interrupt mask register that lets this card's interrupts through. */
+static unsigned char *expcard_intmask;
+static int expcard_intbit;
+
+/*
+ * The bit in the card's own status byte that means "I am interrupting".
+ *
+ * An expansion card declares this in byte 12 of its extended identity, but
+ * the podule manager does not report it, and the value is one for every card
+ * that has ever needed it. What matters far more is that this is the card's
+ * own byte and its own bit: claiming with the podule manager's IntRequest and
+ * IntValue instead gets you IOMD's shared registers, which match every podule
+ * interrupt in the machine. The kernel calls only the first claimant that
+ * matches (PIRQ_Despatch in Kernel s.NewIRQs jumps rather than returns), so a
+ * driver that claims the shared registers starves every other card.
+ */
+#define EXPCARD_IRQ_BIT 1
+
+/*
+ * Where in the card's EASI space the controller's registers appear. Zero
+ * would leave nowhere for the card's own ROM, so cards put them further in;
+ * RPCEmu's USB card uses 8M.
+ */
+#define OHCI_EXPCARD_OFFSET 0x800000
+
+/*
+ * How much I/O space an expansion card gets, and therefore what to round the
+ * podule manager's combined address down to.
+ *
+ * The combined address is where the card's ROM starts, which is not where the
+ * card starts: on this machine it came back as &F99C4074, and the byte there
+ * reads zero. The interrupt status byte is at the bottom of the card's I/O
+ * space, &F99C4000, which reads &fa - the identity byte the card answers with
+ * its interrupt line low, and &fb with it high. Hand the kernel the ROM
+ * address instead and its LDRB finds nothing, the chain never matches, and
+ * the interrupt is asserted for ever with nobody to clear it.
+ */
+#define EXPCARD_IO_SIZE 0x4000
+
+/* The podule manager returns these in ascending bit order, so the order of
+   the bits below is the order of the words in the block.
+
+   The combined address is the one expansion card code is handed in r11, and
+   the card's interrupt status byte lives at the front of it. */
+#define OHCI_EXPCARD_READINFO (Podule_ReadInfo_CombinedAddress  | \
+                               Podule_ReadInfo_EASILogical      | \
+                               Podule_ReadInfo_IntMask          | \
+                               Podule_ReadInfo_IntValue         | \
+                               Podule_ReadInfo_IntDeviceVector)
+
+typedef struct
+{
+    unsigned char *combined;
+    unsigned char *easi;
+    unsigned char *intmask;
+    int            intbit;
+    int            devno;
+} expcard_info;
+
+/*
+ * Give the controller's interrupt back.
+ *
+ * Three places do this - finalisation, a pre-reset service call, and the
+ * error path - and an expansion card has to be released differently from a
+ * PCI or HAL device, so they share one function rather than three copies
+ * that can drift apart.
+ */
+static void release_usb_irq(void *pw);
+
 int device_number;
 int registers_32bit=0;
 static bool registering=false; /* True/false for whether we're in the middle of registering. Avoids nested registration attempt during ROM init. */
+static bool registered_resources=false; /* Did this instance put the messages into ResourceFS? Only it may take them out again. */
+
+/*
+ * Look for an OHCI controller on the expansion cards.
+ *
+ * slot is a single card to try, or EXPCARD_NONE to try them all. On success
+ * hci_base, device_number, expcard_base and the interrupt details are set.
+ */
+static _kernel_oserror *find_expansion_card_controller(int slot)
+{
+    static const _kernel_tokerror err_noohci = ErrorBlock_OHCI_NoOHCI;
+    int first = (slot == EXPCARD_NONE) ? 0 : slot;
+    int last  = (slot == EXPCARD_NONE) ? EXPCARD_COUNT - 1 : slot;
+    int s;
+
+    for (s = first; s <= last; s++)
+    {
+        expcard_info card;
+        volatile int *regs;
+
+        if (_swix(Podule_ReadInfo, _INR(0,3),
+                  OHCI_EXPCARD_READINFO, &card, sizeof card, s) != NULL)
+            continue;                   /* no card in this slot */
+
+        if (card.easi == NULL)
+            continue;                   /* no EASI space, so nowhere to be */
+
+        /* A card that declares EASI space says nothing about what is in it,
+           so ask the thing itself what it is before writing to it. */
+        regs = (volatile int *) (card.easi + OHCI_EXPCARD_OFFSET);
+        if ((regs[OHCI_REVISION / 4] & 0xFF) != 0x10)
+            continue;
+
+        dprintf (("", "Found OHCI controller on expansion card %d\n", s));
+
+        hci_base        = regs;
+        expcard_base    = ((int) card.combined) & ~(EXPCARD_IO_SIZE - 1);
+        device_number   = card.devno;
+        expcard_intmask = card.intmask;
+        expcard_intbit  = card.intbit;
+        return NULL;
+    }
+
+    return _swix (MessageTrans_ErrorLookup, _INR(0,2),
+                  &err_noohci, &mod_messages, 0 /* Internal buffer */);
+}
+
+static void release_usb_irq(void *pw)
+{
+    if (expcard_base != 0)
+    {
+        /* The kernel matches a podule chain node on all four of address,
+           mask, call address and r12, so the release has to repeat exactly
+           what the claim said or it finds nothing to release. */
+        _swix (OS_ReleaseDeviceVector, _INR(0,4),
+            device_number, usb_irq_entry, pw,
+            expcard_base, EXPCARD_IRQ_BIT);
+    }
+    else
+    {
+        _swix (OS_ReleaseDeviceVector, _INR(0,2),
+            device_number | ((pci_device == -1)?0:(1u<<31)),
+            usb_irq_entry, pw);
+    }
+}
 
