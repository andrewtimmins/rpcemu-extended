# Build trees
/build/
/build-*/

# Release staging
/releases/

# macOS cross-compile (osxcross): work tree, the user-provided macOS SDK (large,
# Apple-licensed - never commit), and the generated env file.
/.macos-cross/
/macos-sdk/
/macos-cross-env.sh

# Built binaries at project root
/rpcemu-recompiler
/rpcemu-interpreter
/rpcemu-recompiler-debug
/rpcemu-interpreter-debug
/rpcemu-*
/RPCEmu-*

# Local debug / scratch
/rpclog.txt
/hd4.hdf

# Per-machine runtime state (CMOS, HostFS, disc images) and the shared HostFS
# drive: generated at run time, not source. No machine is shipped, so nothing
# under here is tracked bar the note that keeps the directory in a checkout.
/machines/*
!/machines/README.txt
/shared/

# Machine configurations and ROM images, for the same reason: a machine is made
# by the person running the emulator, and the ROM is downloaded from RISC OS
# Open rather than shipped. Both directories are packaged from whatever is on
# disk, so ignoring their contents costs a local build nothing.
/configs/*
!/configs/README.txt
/roms/*
!/roms/roms.txt

# Package Manager cache, and the repository list it writes beside it. Both are
# created in whatever the emulator takes as its data directory, so running
# something like --pkg-list from a source tree without RPCEMU_DATADIR set leaves
# them here rather than in an installation.
/pkgcache/
/pkgsources

# Legacy single-machine state (CMOS now lives under machines/<name>/)
/cmos.ram
/rpc.cfg

# Emulator configuration settings
/rpcemu.cfg

# Local tool / editor settings
/.claude/

# Intermediates from assembling the guest modules. The assembled ,ffa modules
# are tracked (poduleroms/ ships them; build.sh --podules regenerates them), but
# the object files and the version include generated from VersionNum are not.
/riscos-progs/*/*.o
/riscos-progs/*/*.elf
/riscos-progs/*/version.inc
/riscos-progs/*/resfs.inc
/riscos-progs/RPCEmuGfx/gfxapp

# Editor swap files / patch leftovers
*.swp
*~
*.orig
*.rej
*.bak
.DS_Store

# Bytecode from the Python test helpers (tests/, tools/mcp/)
__pycache__/
*.pyc

# Upstream reference sources (Arculator etc.) - study only, never committed
/reference/
