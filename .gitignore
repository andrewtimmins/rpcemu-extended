# Build trees
/build/
/build-*/

# Release staging
/releases/

# macOS cross-compile (osxcross): work tree, the user-provided macOS SDK (large,
# Apple-licensed - never commit), and the generated env file.
/.macos-cross/
/macos-sdk/
/macos-cross-env.sh

# Built binaries at project root
/rpcemu-recompiler
/rpcemu-interpreter
/rpcemu-recompiler-debug
/rpcemu-interpreter-debug
/rpcemu-*
/RPCEmu-*

# Local debug / scratch
/rpclog.txt
/hd4.hdf

# Per-machine runtime state (CMOS, HostFS, disc images) and the shared HostFS
# drive. Generated/used at run time, not source -- except the Default machine's
# CMOS, which we track so the stock machine keeps its saved configuration.
/machines/*
!/machines/Default/
/machines/Default/*
!/machines/Default/cmos.ram
/shared/

# Legacy single-machine state (CMOS now lives under machines/<name>/)
/cmos.ram
/rpc.cfg

# Local tool / editor settings
/.claude/

# Intermediates from assembling the guest modules. The assembled ,ffa modules
# are tracked (poduleroms/ ships them; build.sh --podules regenerates them), but
# the object files and the version include generated from VersionNum are not.
/riscos-progs/*/*.o
/riscos-progs/*/*.elf
/riscos-progs/*/version.inc

# Editor swap files / patch leftovers
*.swp
*~
*.orig
*.rej
*.bak
.DS_Store

# Bytecode from the Python test helpers (tests/, tools/mcp/)
__pycache__/
*.pyc

# Upstream reference sources (Arculator etc.) - study only, never committed
/reference/
